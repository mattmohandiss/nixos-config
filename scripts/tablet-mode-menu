#!/usr/bin/env bash

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
STATE_FILE="${STATE_DIR}/tablet-mode"

mkdir -p "$STATE_DIR"

if [[ "${1:-}" == "--status" ]]; then
  if [[ -f "$STATE_FILE" ]] && [[ "$(<"$STATE_FILE")" == "on" ]]; then
    printf 'on\n'
  else
    printf 'off\n'
  fi
  exit 0
fi

case "${1:-}" in
  --on) next_state="on" ;;
  --off) next_state="off" ;;
  *)
    if [[ -f "$STATE_FILE" ]] && [[ "$(<"$STATE_FILE")" == "on" ]]; then
      next_state="off"
    else
      next_state="on"
    fi
    ;;
esac

tmp_file="$(mktemp "${STATE_FILE}.XXXXXX")"
trap 'rm -f "$tmp_file"' EXIT
printf '%s\n' "$next_state" > "$tmp_file"
mv -f "$tmp_file" "$STATE_FILE"
