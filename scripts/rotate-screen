#!/usr/bin/env bash

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
STATE_FILE="${STATE_DIR}/screen-rotation"
OUTPUT="${NIRI_OUTPUT:-eDP-1}"

mkdir -p "$STATE_DIR"

if [[ "${1:-}" == "--status" ]]; then
  if [[ -f "$STATE_FILE" ]]; then
    printf '%s\n' "$(<"$STATE_FILE")"
  else
    printf 'normal\n'
  fi
  exit 0
fi

current_rotation="normal"
if [[ -f "$STATE_FILE" ]]; then
  current_rotation="$(<"$STATE_FILE")"
fi

case "$current_rotation" in
  normal) next_rotation="90" ;;
  90) next_rotation="180" ;;
  180) next_rotation="270" ;;
  270) next_rotation="normal" ;;
  *) next_rotation="90" ;;
esac

niri msg output "$OUTPUT" transform "$next_rotation"
printf '%s\n' "$next_rotation" > "$STATE_FILE"
